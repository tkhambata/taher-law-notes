---
import { subjects } from '../data/subjects.json';
---

<div class="student-dashboard not-content">
  <section class="welcome-panel" aria-labelledby="workspace-heading">
    <p class="eyebrow">YOUR LAW STUDY WORKSPACE</p>
    <h2 id="workspace-heading">Make room for clearer thinking.</h2>
    <p class="welcome-copy">
      Bring your notes, authorities and revision together. Choose a subject,
      connect the key ideas, and return to what matters.
    </p>
    <div class="welcome-actions">
      <a class="primary-action" href="#subjects">Explore subjects <span aria-hidden="true">&#8595;</span></a>
      <a class="secondary-action" href="#study-approach">A simple study approach</a>
    </div>
    <p class="search-hint">Looking for a particular topic? Use the search at the top of the page.</p>
  </section>

  <section class="subjects-section" aria-labelledby="subjects">
    <div class="section-heading">
      <p class="eyebrow">YOUR SUBJECTS</p>
      <h2 id="subjects">Where are you studying today?</h2>
      <p>Choose a subject to open its overview and browse the available notes.</p>
    </div>
    <div class="subject-grid">
      {subjects.map((subject, index) => (
        <a class="subject-card" href={subject.href} data-subject-card>
          <span class="card-topline" aria-hidden="true">
            <span class="subject-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="card-arrow">&#8599;</span>
          </span>
          <h3>{subject.title}</h3>
          <p>{subject.description}</p>
          <span class="card-link">Open subject <span aria-hidden="true">&#8594;</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="study-section" aria-labelledby="study-approach">
    <div class="section-heading">
      <p class="eyebrow">FROM READING TO REVISION</p>
      <h2 id="study-approach">Give each study session a clear shape.</h2>
    </div>
    <ol class="study-steps">
      <li><span class="step-label">01 / Understand</span><h3>Connect the ideas</h3><p>Read the topic, identify the central question, and put the principle into your own words.</p></li>
      <li><span class="step-label">02 / Verify</span><h3>Return to authority</h3><p>Check the relevant cases, legislation and course materials. Note the jurisdiction and date.</p></li>
      <li><span class="step-label">03 / Apply</span><h3>Test your reasoning</h3><p>Use a problem question to practise applying the rule and explaining uncertainty.</p></li>
    </ol>
  </section>

  <aside class="study-notice" aria-label="About these notes">
    <span aria-hidden="true">&#167;</span>
    <p>Personal study notes, not legal advice. Check the applicable jurisdiction,
      current law and primary sources before relying on any proposition.</p>
  </aside>
</div>

<style>
  .student-dashboard { --dashboard-teal: #72dcc6; display: grid; gap: 3rem; }
  :global([data-theme='light']) .student-dashboard { --dashboard-teal: #087f72; }
  .welcome-panel { position: relative; overflow: hidden; padding: clamp(1.4rem, 4vw, 2.5rem); border: 1px solid var(--sl-color-gray-5); border-radius: 1.2rem; background: linear-gradient(125deg, var(--sl-color-accent-low), var(--sl-color-bg) 78%); }
  .welcome-panel::after { content: ''; position: absolute; width: 11rem; height: 11rem; right: -5.5rem; top: -5.5rem; border: 1.5rem solid var(--sl-color-accent); border-radius: 50%; opacity: .1; pointer-events: none; }
  .eyebrow { margin: 0 0 .8rem; font-size: .73rem; font-weight: 700; letter-spacing: .13em; color: var(--sl-color-text-accent); }
  .welcome-panel h2 { max-width: 18ch; margin: 0; font-size: clamp(1.8rem, 3.4vw, 2.8rem); line-height: 1.16; letter-spacing: -.035em; color: var(--sl-color-white); text-wrap: balance; }
  .welcome-copy { max-width: 56ch; margin: 1rem 0 0; color: var(--sl-color-text); line-height: 1.75; }
  .welcome-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; margin-top: 1.5rem; }
  .primary-action, .secondary-action { display: inline-flex; align-items: center; gap: .8rem; min-height: 2.75rem; font-size: .93rem; font-weight: 600; text-decoration: none; }
  .primary-action { padding: .65rem 1rem; border-radius: .65rem; background: var(--sl-color-text-accent); color: var(--sl-color-bg); }
  .secondary-action { color: var(--sl-color-white); text-underline-offset: .25em; }
  .secondary-action:hover { text-decoration: underline; }
  .search-hint { margin: 1.3rem 0 0; font-size: .85rem; color: var(--sl-color-gray-2); }
  .section-heading { margin-bottom: 1.25rem; }
  .section-heading .eyebrow { margin-bottom: .55rem; }
  .section-heading h2 { margin: 0; font-size: clamp(1.4rem, 2.5vw, 1.85rem); line-height: 1.3; letter-spacing: -.025em; color: var(--sl-color-white); text-wrap: balance; }
  .section-heading > p:last-child:not(.eyebrow) { margin: .7rem 0 0; color: var(--sl-color-gray-2); line-height: 1.65; }
  .subject-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .subject-card { display: flex; flex-direction: column; min-width: 0; padding: 1.3rem; border: 1px solid var(--sl-color-gray-5); border-radius: .9rem; background: var(--sl-color-bg-nav); color: var(--sl-color-text); text-decoration: none; transition: border-color .15s ease, transform .15s ease; }
  .subject-card:nth-child(even) { border-top: 3px solid var(--dashboard-teal); }
  .subject-card:nth-child(odd) { border-top: 3px solid var(--sl-color-accent); }
  .subject-card:hover { border-color: var(--sl-color-text-accent); transform: translateY(-2px); }
  .card-topline { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.4rem; color: var(--sl-color-text-accent); }
  .subject-number { font-size: .76rem; font-weight: 700; letter-spacing: .08em; }
  .card-arrow { font-size: 1.3rem; line-height: 1; }
  .subject-card h3 { margin: 0; font-size: 1.18rem; line-height: 1.35; color: var(--sl-color-white); }
  .subject-card p { margin: .65rem 0 1.3rem; font-size: .93rem; line-height: 1.7; overflow-wrap: anywhere; }
  .card-link { display: flex; gap: .6rem; align-items: center; margin-top: auto; font-size: .84rem; font-weight: 600; color: var(--sl-color-text-accent); }
  .study-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; padding: 0; margin: 0; list-style: none; }
  .study-steps li { padding-top: 1rem; border-top: 1px solid var(--sl-color-gray-4); }
  .step-label { font-size: .73rem; font-weight: 600; letter-spacing: .035em; color: var(--dashboard-teal); }
  .study-steps h3 { margin: .65rem 0 .5rem; font-size: 1rem; color: var(--sl-color-white); }
  .study-steps p { margin: 0; font-size: .9rem; line-height: 1.75; color: var(--sl-color-gray-2); }
  .study-notice { display: flex; gap: .9rem; align-items: flex-start; padding: 1rem 1.15rem; border: 1px solid var(--sl-color-gray-5); border-radius: .7rem; }
  .study-notice > span { font-family: Georgia, serif; font-size: 1.6rem; color: var(--sl-color-text-accent); }
  .study-notice p { margin: 0; font-size: .83rem; line-height: 1.75; color: var(--sl-color-gray-2); }
  a:focus-visible { outline: 3px solid var(--sl-color-text-accent); outline-offset: 4px; }
  [id] { scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1.5rem); }
  @media (max-width: 42rem) { .study-steps { grid-template-columns: 1fr; } .student-dashboard { gap: 2.25rem; } }
  @media (prefers-reduced-motion: reduce) { .subject-card { transition: none; } .subject-card:hover { transform: none; } }
</style>
